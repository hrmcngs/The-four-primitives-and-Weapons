(load "lisp/generate/commands.lisp")
(load "lisp/maintenance/lock-codes.lisp")
(in-package :maw-tools)
(assert (= 49 (length (variant-names))))
(assert (equal "dreamwing" (car (last (variant-names)))))
(assert (equal (encode (object "flag" :true "name" "刀\"")) "{flag:1b,name:\"刀\\\"\"}"))
(let* ((source "{\"text\":\"刀\\n\\uD83E\\uDD8B\",\"v\":[true,false,null,12,-3.5]}")
       (parsed (parse-json source)) (again (parse-json (encode parsed t))))
  (assert (equal (gethash "text" parsed) (gethash "text" again)))
  (assert (eq :false (aref (gethash "v" again) 1))))
(assert (not (coordinate-valid-p "~;kill")))
(assert (not (coordinate-valid-p "#.(quit)")))
(assert (coordinate-valid-p "~-1.5"))
(assert (not (coordinate-valid-p "~~1")))
(let ((*standard-input* (make-string-input-stream (format nil "1~%2~%2~%2~%2~%刀~%1~%~~ ~~1.5 ~~~%90~%85~%0~%1.5~%")))
      (*standard-output* (make-broadcast-stream)))
  (let ((command (weapon-command)))
    (assert (search "stabbed_weapon ~ ~1.5 ~" command))
    (assert (search "DisappearOnPickup:1b" command))
    (assert (search "StabScale:1.5f" command))))
;; Both output modes must carry shape, wrap and independently selected RGB values.
(dolist (mode '(1 2))
  (let ((*standard-input* (make-string-input-stream
           (format nil "1~%~D~%1~%7~%3~%1~%4~%3~%1~%1~%1~%1~%2~%~%2~%~%~%~%~%~%" mode)))
        (*standard-output* (make-broadcast-stream)))
    (let ((command (weapon-command)))
      (assert (search "TsubaStyle:\"mokko\"" command))
      (assert (search "TsukaWrap:\"katate\"" command))
      (assert (search "TsukaColor:2434347" command))
      (assert (search "TsukaBaseColor:16777215" command))
      (if (= mode 1) (assert (search "/give @p" command))
          (assert (search "StabItem:{id:" command))))))
;; Color-only selection enables two-color rendering; omitted colors stay absent.
(let ((*standard-input* (make-string-input-stream (format nil "2~%1~%1~%4~%1~%1~%1~%1~%")))
      (*standard-output* (make-broadcast-stream)))
  (let ((tag (weapon-fittings (object))))
    (assert (equal "hineri" (gethash "TsukaWrap" tag)))
    (assert (= #x25252B (gethash "TsukaBaseColor" tag)))
    (assert (not (gethash "TsukaColor" tag)))))
(let ((*tinker-material-catalog* (make-hash-table :test #'equal)))
  (dolist (id '("tconstruct:iron" "ticex:draconium"))
    (setf (gethash id *tinker-material-catalog*)
          (object "tconstruct:head" (object) "tconstruct:binding" (object))))
  (dolist (source '(11 12))
    (dolist (mode '(1 2))
      (let ((*standard-input* (make-string-input-stream
                (format nil "~D~%~D~%1~%1~%1~%2~%~%2~%~%~%~%~%~%" source mode)))
            (*standard-output* (make-broadcast-stream)))
        (let* ((command (weapon-command))
               (material (if (= source 11) "tconstruct:iron" "ticex:draconium")))
          (assert (search "the_four_primitives_and_weapons:ticex_katana" command))
          (assert (search (format nil "tic_materials:[~S,~S,~S,~S]"
                           material "tconstruct:wood" material material) command))
          (assert (not (search "tic_stats" command)))
          (assert (not (search "TsukaColor" command)))
          (if (= mode 1) (assert (search "/give @p" command))
              (assert (search "StabItem:{id:" command))))))))
(assert (material-id-valid-p "ticex:draconium"))
(assert (not (material-id-valid-p "ticex:bad;kill")))
(assert (not (material-id-valid-p "ticex:")))
;; Only offer surfaces and designs that exist on each weapon.
(let ((rapier (weapon-capabilities "the_four_primitives_and_weapons:iron_rapier"))
      (dagger (weapon-capabilities "the_four_primitives_and_weapons:iron_dagger"))
      (vanilla (weapon-capabilities "minecraft:iron_sword"))
      (practice (weapon-capabilities "the_four_primitives_and_weapons:wooden_katana")))
  (assert (getf rapier :rapier))
  (assert (not (getf rapier :wrap)))
  (assert (not (getf dagger :shape)))
  (assert (assoc "刀身" (getf dagger :colors) :test #'equal))
  (assert (not (getf vanilla :colors)))
  (assert (not (getf practice :colors))))
(let ((*standard-input* (make-string-input-stream (format nil "1~%2~%2~%2~%2~%")))
      (*standard-output* (make-broadcast-stream)))
  (let ((tag (weapon-fittings (object) "the_four_primitives_and_weapons:iron_rapier")))
    (assert (equal (gethash "TsukaWrap" tag) "grip_b"))
    (assert (equal (gethash "TsubaStyle" tag) "guard_b"))
    (assert (equal (gethash "KashiraStyle" tag) "pommel_b"))))
(let ((*standard-input* (make-string-input-stream (format nil "2~%1~%4~%3~%5~%")))
      (*standard-output* (make-broadcast-stream)))
  (let ((tag (weapon-fittings (object) "the_four_primitives_and_weapons:iron_dagger")))
    (assert (= #x25252B (gethash "TsukaColor" tag)))
    (assert (= #xFFFFFF (gethash "TsubaColor" tag)))
    (assert (= #x278EDE (gethash "BladeColor" tag)))
    (assert (not (gethash "TsukaBaseColor" tag)))))
(let ((*tinker-material-catalog* (make-hash-table :test #'equal)))
  (dolist (id '("tconstruct:iron" "ticex:draconium"))
    (setf (gethash id *tinker-material-catalog*)
          (object "tconstruct:head" (object "durability" 250 "melee_attack" 2)
                  "tconstruct:limb" (object "durability" 600)
                  "tconstruct:plating_shield" (object "durability" 500))))
  (dolist (item '("minecraft:iron_sword" "minecraft:bow" "minecraft:crossbow" "minecraft:shield" "minecraft:trident"))
    (let ((*standard-input* (make-string-input-stream (format nil "1~%2~%1~%")))
          (*standard-output* (make-broadcast-stream)))
      (let* ((tag (object)) (result (material-weapon-options tag item))
             (data (gethash "TFPW_TicexMaterial" result)))
        (assert (equal "ticex:draconium" (gethash "Id" data)))
        (assert (= 2 (gethash "Attack" data)))
        (assert (= (cond ((equal item "minecraft:shield") 500)
                         ((member item '("minecraft:bow" "minecraft:crossbow") :test #'equal) 600) (t 250))
                   (gethash "Durability" data)))))))
;; Selection of a vanilla sword through the type menu must not ask katana-only questions.
(let* ((types (weapon-type-data))
       (keys (loop for key being the hash-keys of types using (hash-value data)
                   when (plusp (length (gethash "items" data))) collect key))
       (swords (gethash "items" (gethash "sword" types)))
       (*standard-input* (make-string-input-stream
          (format nil "13~%~D~%~D~%1~%2~%~%2~%"
                  (1+ (position "sword" keys :test #'equal))
                  (1+ (position "minecraft:iron_sword" swords :test #'equal)))))
       (*standard-output* (make-broadcast-stream)))
  (assert (search "/give @p minecraft:iron_sword" (weapon-command))))
;; Non-katana pattern choices are backed by textures in each part's actual folder.
(let ((parts (weapon-part-designs "the_four_primitives_and_weapons:iron_dagger")))
  (assert (= 2 (length parts)))
  (assert (member "diamond_grip" (third (first parts)) :test #'equal))
  (assert (notany (lambda (part) (some (lambda (name) (or (search "_gray" name) (search "template" name))) (third part))) parts)))
(let ((*standard-input* (make-string-input-stream (format nil "1~%2~%2~%")))
      (*standard-output* (make-broadcast-stream)))
  (let ((tag (object)))
    (weapon-pattern-options tag "the_four_primitives_and_weapons:iron_dagger")
    (assert (equal "diamond_grip" (gethash "TsukaWrap" tag)))
    (assert (equal "diamond_tuba" (gethash "TsubaStyle" tag)))))
(let ((*standard-input* (make-string-input-stream (format nil "1~%3~%3~%3~%")))
      (*standard-output* (make-broadcast-stream)))
  (let ((tag (object)))
    (weapon-pattern-options tag "the_four_primitives_and_weapons:copper_sword")
    (assert (equal "golden" (gethash "TsukaWrap" tag)))
    (assert (equal "golden" (gethash "TsubaStyle" tag)))
    (assert (equal "golden" (gethash "KashiraStyle" tag)))))
(let ((*standard-input* (make-string-input-stream (format nil "1~%12~%3~%7~%1~%9~%15~%")))
      (*standard-output* (make-broadcast-stream)))
  (let* ((tag (object)) (result (weapon-pattern-options tag "minecraft:shield"))
         (be (gethash "BlockEntityTag" result)) (layers (gethash "Patterns" be)))
    (assert (= 11 (gethash "Base" be)))
    (assert (= 2 (length layers)))
    (assert (equal "cr" (gethash "Pattern" (aref layers 0))))
    (assert (= 0 (gethash "Color" (aref layers 0))))
    (assert (equal "bo" (gethash "Pattern" (aref layers 1))))
    (assert (= 14 (gethash "Color" (aref layers 1))))))
(assert (not (weapon-part-designs "minecraft:bow")))
(assert (not (weapon-part-designs "the_four_primitives_and_weapons:wooden_rapier")))
(let ((*standard-input* (make-string-input-stream
         (format nil "14~%the_four_primitives_and_weapons:iron_dagger~%1~%1~%2~%2~%2~%2~%~%2~%")))
      (*standard-output* (make-broadcast-stream)))
  (let ((command (weapon-command)))
    (assert (search "/give @p the_four_primitives_and_weapons:iron_dagger" command))
    (assert (search "TsukaWrap:\"diamond_grip\"" command))
    (assert (search "TsubaStyle:\"diamond_tuba\"" command))))
;; Straight and short blades expose procedural wraps and real guard shapes.
(dolist (item '("the_four_primitives_and_weapons:iron_tyokuto" "the_four_primitives_and_weapons:small_sword" "the_four_primitives_and_weapons:warabitetou"))
  (let ((caps (weapon-capabilities item)))
    (assert (getf caps :shape)) (assert (getf caps :wrap))
    (assert (assoc "柄の下地" (getf caps :colors) :test #'equal)))
  (let ((*standard-input* (make-string-input-stream (format nil "1~%8~%6~%2~%")))
        (*standard-output* (make-broadcast-stream)))
    (let ((tag (weapon-fittings (object) item)))
      (assert (equal "hexagon" (gethash "TsubaStyle" tag)))
      (assert (equal "basket" (gethash "TsukaWrap" tag))))))
(let* ((path (format nil "/tmp/maw-lock-test-~D.json" (get-universal-time)))
       (source "{\"mod_elements\":[{\"locked_code\":false},{\"locked_code\":true},{\"name\":\"新規\"}],\"other\":17}"))
  (unwind-protect
      (progn (write-text path source) (lock-workspace path)
             (let ((d (parse-json (read-text path))))
               (assert (= 17 (gethash "other" d)))
               (assert (eq :true (gethash "locked_code" (aref (gethash "mod_elements" d) 0))))
               (assert (not (gethash "locked_code" (aref (gethash "mod_elements" d) 2)))))
             (assert (equal source (read-text (concatenate 'string path ".backup_auto"))))
    (delete-file path) (delete-file (concatenate 'string path ".backup_auto")))))
(format t "Lisp command/JSON/NBT/lock tests passed.~%")

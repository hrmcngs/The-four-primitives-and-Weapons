(in-package :maw-tools)

(defun weapon-type-data ()
  (let ((types (gethash "types" (parse-json (read-text "src/main/resources/data/the_four_primitives_and_weapons/weapon_types/weapon_types.json")))))
    (loop for data being the hash-values of types do
      (setf (gethash "items" data)
        (coerce (loop for item across (gethash "items" data)
                      for id = (if (equal item "the_four_primitives_and_weapons:magischesfeen_katana")
                                   "the_four_primitives_and_weapons:magisches_feen_katana" item)
                      unless (and (uiop:string-prefix-p "the_four_primitives_and_weapons:" id)
                                  (not (probe-file (format nil "src/main/resources/assets/the_four_primitives_and_weapons/models/item/~A.json"
                                                     (subseq id (1+ (position #\: id)))))))
                        collect id) 'vector)))
    types))
(defun weapon-type-id (item)
  (loop for type being the hash-keys of (weapon-type-data) using (hash-value data)
        when (find item (gethash "items" data) :test #'equal) return type))
(defun local-item-name (item)
  (let* ((parts (uiop:split-string item :separator ":"))
         (file (format nil "src/main/resources/assets/~A/lang/ja_jp.json" (first parts)))
         (translations (and (probe-file file) (parse-json (read-text file)))))
    (format nil "~A (~A)" (or (and translations (gethash (format nil "item.~A.~A" (first parts) (second parts)) translations)) item) item)))
(defun pick-other-weapon ()
  (let* ((types (weapon-type-data))
         (keys (loop for key being the hash-keys of types using (hash-value data)
                     when (plusp (length (gethash "items" data))) collect key))
         (type (nth (choose "武器タイプ" (mapcar (lambda (key) (gethash "display_name" (gethash key types) key)) keys)) keys))
         (items (coerce (gethash "items" (gethash type types)) 'list)))
    (nth (choose "武器" (mapcar #'local-item-name items)) items)))
(defun local-model (id &optional (depth 0))
  (when (> depth 16) (return-from local-model nil))
  (let* ((parts (uiop:split-string id :separator ":"))
         (file (format nil "src/main/resources/assets/~A/models/~A.json" (first parts) (second parts))))
    (when (probe-file file)
      (let* ((model (parse-json (read-text file))) (parent (gethash "parent" model))
             (inherited (and parent (local-model parent (1+ depth)))))
        (unless (gethash "elements" model) (setf (gethash "elements" model) (and inherited (gethash "elements" inherited))))
        (let ((textures (make-hash-table :test #'equal)))
          (when (and inherited (gethash "textures" inherited))
            (maphash (lambda (key value) (setf (gethash key textures) value)) (gethash "textures" inherited)))
          (when (gethash "textures" model)
            (maphash (lambda (key value) (setf (gethash key textures) value)) (gethash "textures" model)))
          (setf (gethash "textures" model) textures))
        model))))
(defun weapon-tints (item)
  (let ((model (local-model (let ((colon (position #\: item)))
                              (format nil "~A:item/~A" (subseq item 0 colon) (subseq item (1+ colon)))))))
    (remove-duplicates
      (loop for element across (or (and model (gethash "elements" model)) #())
            append (loop for face being the hash-values of (gethash "faces" element)
                         for tint = (gethash "tintindex" face) when tint collect tint)))))
(defun practice-weapon-p (item)
  (find item (gethash "values" (parse-json (read-text
    "src/main/resources/data/the_four_primitives_and_weapons/tags/items/koshirae/practice_weapon.json"))) :test #'equal))
(defun weapon-capabilities (item)
  (let* ((type (weapon-type-id item)) (tints (weapon-tints item))
         (katana (or (member type '("katana" "straight_sword" "small_sword") :test #'equal)
                     (and (uiop:string-prefix-p "the_four_primitives_and_weapons:" item)
                          (or (search "katana" item) (search "tyokuto" item)))))
         (native (equal item "the_four_primitives_and_weapons:ticex_katana"))
         (practice (practice-weapon-p item))
         (pairs nil))
    ;; Reflect the model's actual tint surfaces; avoid offering silent no-op settings.
    (unless (or practice native)
      (when (member 1 tints) (push (list (if katana "柄巻の紐" "柄") "TsukaColor") pairs))
      (when (and katana (member 1 tints)) (push '("柄の下地" "TsukaBaseColor") pairs))
      (when (member 2 tints) (push '("鍔" "TsubaColor") pairs))
      (when (member 3 tints) (push '("頭" "KashiraColor") pairs))
      (when (member 5 tints) (push '("はばき" "HabakiColor") pairs))
      (when (or (member 6 tints) (member 7 tints)) (push '("刀身" "BladeColor") pairs))
)
    (list :type type :shape (and katana (member 2 tints))
          :wrap (and katana (member 1 tints) (not practice) (not native))
          :rapier (and (equal type "rapier") (not practice))
          :colors (nreverse pairs) :native native)))

(defun resolved-texture (texture textures &optional (depth 0))
  (when (and texture (< depth 16))
    (if (uiop:string-prefix-p "#" texture)
        (resolved-texture (gethash (subseq texture 1) textures) textures (1+ depth)) texture)))
(defun fitting-textures (model tint)
  (remove-duplicates
    (loop for element across (or (gethash "elements" model) #())
          append (loop for face being the hash-values of (gethash "faces" element)
                       when (eql tint (gethash "tintindex" face))
                         collect (resolved-texture (gethash "texture" face) (gethash "textures" model)))) :test #'equal))
(defun fitting-siblings (texture)
  (let* ((parts (uiop:split-string texture :separator ":"))
         (folder (make-pathname :name nil :type nil :defaults
                   (format nil "src/main/resources/assets/~A/textures/~A.png" (first parts) (second parts)))))
    (loop for file in (uiop:directory-files folder "*.png")
          for name = (pathname-name file)
          unless (or (uiop:string-suffix-p name "_gray") (uiop:string-suffix-p name "_black") (search "template" name))
            collect name)))
(defun weapon-part-designs (item)
  (let* ((caps (weapon-capabilities item)) (colon (position #\: item))
         (model (local-model (format nil "~A:item/~A" (subseq item 0 colon) (subseq item (1+ colon))))))
    (when (or (getf caps :wrap) (getf caps :rapier) (getf caps :native) (practice-weapon-p item))
      (return-from weapon-part-designs nil))
    (when model
      (loop for (tint label key) in '((1 "柄の模様・仕上げ" "TsukaWrap") (2 "鍔の模様・仕上げ" "TsubaStyle") (3 "頭の模様・仕上げ" "KashiraStyle"))
            for textures = (fitting-textures model tint)
            for files = (when (and textures (every (lambda (texture) (and texture (search "_fitting/" texture))) textures))
                          (reduce (lambda (left right) (intersection left right :test #'equal))
                                  (mapcar #'fitting-siblings textures)))
            for alternatives = (sort (set-difference files (mapcar (lambda (texture) (pathname-name texture)) textures) :test #'equal) #'string<)
            when alternatives collect (list label key alternatives)))))
(defun fitting-design-label (name)
  (or (cdr (assoc (first (uiop:split-string name :separator "_"))
                 '(("diamond" . "ダイヤ風") ("gold" . "金色仕上げ") ("golden" . "金色仕上げ")
                   ("netherite" . "ネザライト風") ("stone" . "石風") ("wooden" . "木製仕上げ")
                   ("iron" . "鉄色仕上げ")) :test #'equal)) name))
(defun weapon-pattern-options (tag item)
  (let ((parts (weapon-part-designs item)))
    (when (and parts (yes "模様・仕上げを設定しますか？"))
      (loop for (label key alternatives) in parts
            for choice = (choose label (cons "既定（変更しない）" (mapcar #'fitting-design-label alternatives)))
            when (> choice 0) do (setf (gethash key tag) (nth (1- choice) alternatives)))))
  (when (and (equal item "minecraft:shield") (yes "盾の地色・旗模様を設定しますか？"))
    (let* ((colors '("白" "橙" "赤紫" "空色" "黄" "黄緑" "桃" "灰" "薄灰" "青緑" "紫" "青" "茶" "緑" "赤" "黒"))
           (patterns '(("下帯" . "bs") ("上帯" . "ts") ("左帯" . "ls") ("右帯" . "rs")
                       ("縦帯" . "cs") ("横帯" . "ms") ("十字" . "cr") ("斜め十字" . "sc")
                       ("縁取り" . "bo") ("ギザギザの縁" . "cbo") ("グラデーション" . "gra")
                       ("下からのグラデーション" . "gru") ("クリーパー" . "cre") ("頭蓋骨" . "sku")
                       ("花" . "flo") ("地球" . "glb") ("ピグリン" . "pig")))
           (base (choose "盾の地色" colors))
           (count (choose "模様の重ね数" '("なし" "1枚" "2枚" "3枚" "4枚" "5枚" "6枚")))
           (layers (loop repeat count collect
              (object "Pattern" (cdr (nth (choose "模様" (mapcar #'car patterns)) patterns))
                      "Color" (choose "模様の色" colors)))))
      (setf (gethash "BlockEntityTag" tag) (object "Base" base "Patterns" (coerce layers 'vector)))))
  tag)

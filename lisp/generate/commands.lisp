(load "lisp/common/core.lisp")
(in-package :maw-tools)
(defparameter *mod* "the_four_primitives_and_weapons")
(defparameter *colors* '( ("指定しない" . nil) ("桜色" . #xE8A6C4) ("白" . #xFFFFFF)
  ("黒" . #x25252B) ("青" . #x278EDE) ("金" . #xEBC55D) ("灰茶" . #x81766B) ("灰緑" . #x747B73)))
(defparameter *weapons* '(("鉄の刀" . "iron_katana") ("鉄の直刀" . "iron_tyokuto")
 ("魔法刀" . "magical_katana") ("上腕骨刀" . "katana_nigu_humerus") ("金の刀" . "gold_katana")
 ("ダイヤの刀" . "diamond_katana") ("ネザライトの刀" . "netherite_katana")
 ("忍者刀" . "ninjatou") ("小太刀" . "small_sword") ("鉄の剣" . "minecraft:iron_sword")))
(load "lisp/generate/weapon-options.lisp")
(defparameter *tsuba-shapes*
  '(("既定（元の形）" . nil) ("楕円" . "oval") ("菱形" . "diamond")
    ("丸形" . "circle") ("角形" . "square") ("八角形" . "octagon") ("木瓜形" . "mokko") ("六角形" . "hexagon")))
(defparameter *tsuka-wraps*
  '(("既定（元の柄）" . nil) ("菱巻風" . "hineri") ("片手巻風" . "katate") ("平巻風" . "hira") ("斜め巻風" . "spiral") ("格子巻風" . "basket")))
(defun weapon-fittings (tag &optional (item "the_four_primitives_and_weapons:iron_katana"))
  (let* ((caps (weapon-capabilities item)) (shape (getf caps :shape)) (wrap (getf caps :wrap)))
    (when (and (or shape wrap) (yes "形・柄巻を設定しますか？"))
      (when shape
        (let ((value (cdr (nth (choose "鍔の形" (mapcar #'car *tsuba-shapes*)) *tsuba-shapes*))))
          (when value (setf (gethash "TsubaStyle" tag) value))))
      (when wrap
        (let ((value (cdr (nth (choose "柄の巻き方" (mapcar #'car *tsuka-wraps*)) *tsuka-wraps*))))
          (when value (setf (gethash "TsukaWrap" tag) value)))))
    (when (and (getf caps :rapier) (yes "細剣の柄・鍔・頭のデザインを設定しますか？"))
      (loop for (label key alternate) in '(("柄" "TsukaWrap" "grip_b") ("鍔" "TsubaStyle" "guard_b") ("頭" "KashiraStyle" "pommel_b"))
            when (= 1 (choose label '("既定" "別デザイン"))) do (setf (gethash key tag) alternate)))
    (weapon-pattern-options tag item)
    (when (and (getf caps :colors) (yes "部位の色を設定しますか？"))
      (put-colors tag (getf caps :colors))
      (when (and wrap (or (gethash "TsukaColor" tag) (gethash "TsukaBaseColor" tag))
                 (not (gethash "TsukaWrap" tag)))
        (setf (gethash "TsukaWrap" tag) "hineri"))))
  tag)
(defun pick-color (label)
  (let ((i (choose label (append (mapcar #'car *colors*) '("RGB入力 #RRGGBB")))))
    (if (< i (length *colors*)) (cdr (nth i *colors*))
      (loop for s = (prompt "RGB" "#E8A6C4")
            for hex = (cond ((and (> (length s) 0) (char= (char s 0) #\#)) (subseq s 1))
                           ((and (> (length s) 2) (string-equal s "0x" :end1 2)) (subseq s 2)) (t s))
            when (and (= (length hex) 6) (every (lambda (c) (digit-char-p c 16)) hex))
              return (parse-integer hex :radix 16)
            do (format t "6桁のRGBを入力してください。~%")))))
(defun coordinate-valid-p (s)
  (let ((value (string-left-trim "~^" s)))
    (and (<= (+ (count #\~ s) (count #\^ s)) 1)
       (or (member s '("~" "^") :test #'equal)
        (and (> (length value) 0) (every (lambda (c) (find c "-0123456789.")) value)
             (ignore-errors (let ((*read-eval* nil))
               (multiple-value-bind (v end) (read-from-string value)
                 (and (= end (length value)) (realp v) (<= (abs v) 30000000))))))))))
(defun coordinates ()
  (loop for line = (prompt "出現位置 X Y Z" "~ ~1 ~")
        for parts = (uiop:split-string line :separator '(#\Space #\Tab))
        for coords = (remove "" parts :test #'equal)
        when (and (= (length coords) 3) (every #'coordinate-valid-p coords)
                  (or (every (lambda (s) (char= (char s 0) #\^)) coords)
                      (notany (lambda (s) (find #\^ s)) coords)))
          return (format nil "~{~A~^ ~}" coords)
        do (format t "座標を確認してください。~%")))
(defun variant-names ()
  (loop for line in (uiop:split-string (read-text (format nil "src/main/java/~A/entity/ButterflyVariant.java" *mod*)) :separator '(#\Newline))
        for pos = (search "(0x" line)
        when pos collect (string-downcase (string-trim '(#\Space) (subseq line 0 pos)))))
(defun put-colors (tag pairs)
  (loop for (label key) in pairs for value = (pick-color label)
        when value do (setf (gethash key tag) value)))
(defun butterfly-command ()
  (let* ((names (variant-names)) (i (choose "蝶の種類" (cons "ランダム" names))) (tag (object)))
    (when (> i 0) (setf (gethash "Variant" tag) (nth (1- i) names)))
    (when (yes "色と模様を設定しますか？")
      (put-colors tag '(("羽" "WingColor") ("縁" "EdgeColor") ("模様" "AccentColor") ("胴体" "BodyColor")))
      (let ((pattern (choose "模様" '("プリセットのまま" "翅脈" "翅脈と白斑" "アゲハ縞" "小斑点" "目玉" "帯" "点列" "ジグザグ" "輪郭パネル" "市松" "夢見鳥風（専用の羽形状）"))))
        (when (> pattern 0) (setf (gethash "Pattern" tag) (1- pattern))))
      (let ((tails (choose "尾" '("プリセットのまま" "あり" "なし"))))
        (when (> tails 0) (setf (gethash "Tails" tag) (if (= tails 1) :true :false)))))
    (when (yes "大きさ・羽の形・動きを設定しますか？")
      (loop for (label key low high default) in
        '(("大きさ" "Size" 0.25 4 1) ("羽の幅" "WingWidth" 0.5 2 1) ("羽の長さ" "WingLength" 0.5 2 1)
          ("触角の長さ" "AntennaLength" 0.25 3 1) ("触角の開き（度）" "AntennaSpread" 0 80 25)
          ("触角の傾き（度）" "AntennaTilt" 0 80 20) ("胴体の幅" "BodyWidth" 0.5 2 1)
          ("胴体の長さ" "BodyLength" 0.5 2 1) ("羽の開き角（度）" "FlapRestAngle" 0 80 14.323945)
          ("羽ばたき速度" "FlapSpeed" 0 4 1) ("振幅" "FlapAmount" 0 1.4 0.9) ("飛行速度" "FlightSpeed" 0 3 1))
        do (setf (gethash key tag) (numeric label low high default))))
    (when (yes "その場へ固定しますか？")
      (setf (gethash "NoAI" tag) :true (gethash "NoGravity" tag) :true (gethash "PersistenceRequired" tag) :true))
    (if (= 1 (choose "生成方法" '("直接召喚 /summon" "スポーンエッグ /give")))
        (format nil "/give @p ~A:butterfly_spawn_egg~A 1" *mod* (if (plusp (hash-table-count tag)) (encode (object "EntityTag" tag)) ""))
      (let ((name (prompt "名前 (空欄でなし)")))
        (unless (equal name "") (setf (gethash "CustomName" tag) (encode (object "text" name) t)))
        (format nil "/summon ~A:butterfly ~A~A" *mod* (coordinates)
                (if (plusp (hash-table-count tag)) (concatenate 'string " " (encode tag)) ""))))))
(defparameter *tinker-choices*
  '(("Tinkers連携の四部品の刀" . "tconstruct") ("TiCEX素材の四部品の刀" . "ticex")))
(defvar *tinker-material-catalog* nil)
(defun material-id-valid-p (id)
  (and (= (count #\: id) 1) (not (char= (char id 0) #\:))
       (not (char= (char id (1- (length id))) #\:))
       (every (lambda (c) (find c "abcdefghijklmnopqrstuvwxyz0123456789_./-:")) id)))
(defun read-tinker-material-jar (file catalog)
  (let ((entries (uiop:run-program (list "unzip" "-Z1" (namestring file)) :output :string)))
    (dolist (entry (uiop:split-string entries :separator '(#\Newline)))
      (let ((prefix (search "/tinkering/materials/stats/" entry)))
        (when (and prefix (uiop:string-prefix-p "data/" entry) (uiop:string-suffix-p entry ".json"))
          (let* ((namespace (subseq entry 5 prefix))
                 (material (subseq entry (+ prefix (length "/tinkering/materials/stats/")) (- (length entry) 5)))
                 (id (format nil "~A:~A" namespace material)))
            (unless (gethash id catalog)
              (setf (gethash id catalog)
                    (gethash "stats" (parse-json
                      (uiop:run-program (list "unzip" "-p" (namestring file) entry) :output :string)))))))))))
(defun scan-tinker-materials (folder catalog)
  (when (uiop:directory-exists-p folder)
    (dolist (file (uiop:directory-files folder))
      (let ((name (string-downcase (file-namestring file))))
        (when (and (equal (pathname-type file) "jar")
                   (or (search "tconstruct" name) (search "ticex" name)))
          (read-tinker-material-jar file catalog))))
    (dolist (sub (uiop:subdirectories folder)) (scan-tinker-materials sub catalog))))
(defun tinker-material-catalog ()
  (or *tinker-material-catalog*
      (setf *tinker-material-catalog*
            (let ((catalog (make-hash-table :test #'equal)))
              (scan-tinker-materials "libs/" catalog)
              (scan-tinker-materials "run/mods/" catalog)
              catalog))))
(defun pick-tinker-material (label namespace stat)
  (let* ((catalog (tinker-material-catalog))
         (ids (sort (loop for id being the hash-keys of catalog using (hash-value stats)
                          when (and (uiop:string-prefix-p (concatenate 'string namespace ":") id)
                                    (hash-table-p stats) (some (lambda (key) (gethash key stats)) (if (listp stat) stat (list stat)))) collect id) #'string<))
         (default (or (position (if (equal namespace "ticex") "ticex:draconium" "tconstruct:iron") ids :test #'equal) 0))
         (choice (choose label (append ids '("別の素材IDを入力")) default)))
    (if (< choice (length ids)) (nth choice ids)
        (loop for id = (prompt "素材ID（導入環境に登録済みのID）" (format nil "~A:~A" namespace (if (equal namespace "ticex") "draconium" "iron")))
              when (material-id-valid-p id) return id
              do (format t "namespace:material の形式で入力してください。~%")))))
(defun tinker-materials (tag namespace)
  (format t "Tinkers＋Mantleが必要です。TiCEX素材はTiCEXと素材側の依存MODも導入してください。~%素材一覧はローカルJARから読み取ります。実際の登録状況は起動構成に依存します。~%")
  (let ((blade (pick-tinker-material "刀身の素材" namespace "tconstruct:head"))
        (guard (pick-tinker-material "鍔の素材" namespace "tconstruct:binding"))
        (pommel (pick-tinker-material "頭の素材" namespace "tconstruct:binding")))
    ;; The wooden handle and component order match ticex_katana's tool definition.
    ;; Omit cached stats/modifiers so Tinkers initializes them from the materials.
    (setf (gethash "tic_materials" tag) (vector blade "tconstruct:wood" guard pommel)))
  tag)
(defun material-weapon-stats (item material)
  (let* ((stats (gethash material (tinker-material-catalog)))
         (type (weapon-type-id item))
         (head (and stats (gethash "tconstruct:head" stats)))
         (preferred (cond ((equal type "shield") "tconstruct:plating_shield")
                          ((member type '("bow" "crossbow") :test #'equal) "tconstruct:limb")
                          (t "tconstruct:head")))
         (body (and stats (or (gethash preferred stats) head)))
         (durability (and body (gethash "durability" body)))
         (attack (if head (gethash "melee_attack" head) 2)))
    (when (and (integerp durability) (> durability 0) (realp attack) (>= attack 0))
      (object "Id" material "Durability" durability "Attack" (float attack)))))
(defun material-weapon-options (tag item)
  (when (and (weapon-type-id item) (yes "Tinkers／TiCEXの素材を武器に設定しますか？"))
    (let* ((namespace (nth (choose "素材の種類" '("Tinkers" "TiCEX")) '("tconstruct" "ticex")))
           (type (weapon-type-id item))
           (keys (cond ((equal type "shield") '("tconstruct:plating_shield" "tconstruct:head"))
                       ((member type '("bow" "crossbow") :test #'equal) '("tconstruct:limb" "tconstruct:head"))
                       (t '("tconstruct:head")))))
      (format t "素材の性能はローカルJARの定義から設定します。実際の使用にはTinkers・素材の依存MODが必要です。~%")
      (loop for material = (pick-tinker-material "武器の素材" namespace keys)
            for data = (material-weapon-stats item material)
            when data do (setf (gethash "TFPW_TicexMaterial" tag) data) and return tag
            do (format t "その素材の対応する性能がローカルJARに見つかりません。別の素材を選んでください。~%")))))
(defun item-id ()
  (let* ((choices (append *weapons* (mapcar (lambda (choice) (cons (car choice) "ticex_katana")) *tinker-choices*)))
         (i (choose "刀・武器" (append (mapcar #'car choices) '("他の武器（タイプ別に選択）" "別のアイテムID"))))
         (item (cond ((< i (length choices)) (cdr (nth i choices)))
                     ((= i (length choices)) (pick-other-weapon))
                     (t (loop for s = (prompt "ID" "the_four_primitives_and_weapons:iron_katana")
                       when (and (> (length s) 0) (<= (count #\: s) 1)
                                 (every (lambda (c) (find c "abcdefghijklmnopqrstuvwxyz0123456789_./-:")) s)
                                 (not (char= (char s 0) #\:)) (not (char= (char s (1- (length s))) #\:))) return s)))))
    (values (if (find #\: item) item (format nil "~A:~A" *mod* item))
            (when (and (>= i (length *weapons*)) (< i (length choices)))
              (cdr (nth (- i (length *weapons*)) *tinker-choices*))))))
(defun weapon-command ()
  (let* ((selection (multiple-value-list (item-id))) (item (first selection))
         (mode (choose "生成方法" '("入手 /give" "刺した状態 /summon"))) (tag (object)))
    (when (second selection) (tinker-materials tag (second selection)))
    (when (and (not (second selection)) (equal item "the_four_primitives_and_weapons:ticex_katana"))
      (tinker-materials tag (nth (choose "素材の種類" '("Tinkers" "TiCEX")) '("tconstruct" "ticex"))))
    (weapon-fittings tag item)
    (unless (or (second selection) (equal item "the_four_primitives_and_weapons:ticex_katana"))
      (material-weapon-options tag item))
    (let ((name (prompt "武器の名前 (空欄でなし)")))
      (unless (equal name "") (setf (gethash "display" tag) (object "Name" (encode (object "text" name "italic" :false) t)))))
    (let ((disappear (if (yes "回収したときに消えますか？") :true :false)))
      (setf (gethash "DisappearOnPickup" tag) disappear)
      (if (= mode 0) (format nil "/give @p ~A~A 1" item (encode tag))
        (progn
          (format t "Yは武器の中心。地表から約1.5ブロック上が目安です。~%")
          (let ((pos (coordinates)) (entity (object "StabItem" (object "id" item "Count" 1 "tag" tag) "DisappearOnPickup" disappear)))
            (loop for (label key low high default) in '(("向き" "StabYaw" -180 180 0) ("傾き" "StabTilt" -180 180 8)
                    ("ひねり" "StabRoll" -180 180 0) ("大きさ" "StabScale" 0.1 5 1))
                  do (setf (gethash key entity) (numeric label low high default)))
            (format nil "/summon ~A:stabbed_weapon ~A ~A" *mod* pos (encode entity))))))))
(defun command-main ()
  (format t "蝶・刀 コマンド生成 / Common Lisp / オフライン対応~%Enterで既定値。Ctrl+Cで終了。~%")
  (let ((*random-state* (make-random-state t)) (commands nil) (folder (format nil "run/generated_commands/~D-~D/" (get-universal-time) (random 1000000000))))
    (loop for kind = (choose "何を生成しますか？" '("蝶" "刀・武器" "終了"))
          until (= kind 2) do
      (let ((command (if (= kind 0) (butterfly-command) (weapon-command))))
        (setf commands (append commands (list command)))
        (write-text (concatenate 'string folder "commands.txt") (format nil "~{~A~%~}" commands))
        (write-text (concatenate 'string folder "command_builder/pack.mcmeta")
                    (encode (object "pack" (object "pack_format" 15 "description" "蝶・刀の生成コマンド")) t))
        (write-text (concatenate 'string folder "command_builder/data/command_builder/functions/generated.mcfunction")
                    (format nil "~{~A~%~}" (mapcar (lambda (s) (subseq s 1)) commands))))
      (format t "~%~A~%保存先: ~A~%" (car (last commands)) folder)
      (format t "長いコマンドはコマンドブロックへ。command_builderをワールドのdatapacksへコピーすると、~%/reload → /function command_builder:generated で今回の全コマンドを実行できます。~%")
      (when (and (probe-file "/usr/bin/pbcopy") (yes "クリップボードにコピーしますか？"))
        (uiop:run-program '("/usr/bin/pbcopy") :input (make-string-input-stream (car (last commands)))))
      (unless (yes "続けて作りますか？") (return)))))
(unless (member "--test" (uiop:command-line-arguments) :test #'equal) (run-tool #'command-main))
